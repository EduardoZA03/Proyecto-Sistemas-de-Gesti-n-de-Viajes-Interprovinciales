@model UsuarioClaveVM
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<nav class="text-muted small mb-2">INICIO &gt; <a asp-action="Index" class="text-muted text-decoration-none">USUARIOS</a> &gt; <span class="text-dark fw-bold">RESTABLECER CONTRASEÑA</span></nav>
<h4 class="fw-bold mb-4"><i class="fa-solid fa-key me-2"></i>Restablecer contraseña</h4>

<form asp-action="Clave" asp-route-id="@Model.IdUsuario" method="post" autocomplete="off">
    <div class="card mb-3" style="max-width: 560px;">
        <div class="card-body">
            <p class="mb-3">
                Cuenta: <strong>@Model.NombreUsuario</strong>
                <span class="text-muted">(@Model.NombreCompleto)</span>
            </p>

            <div class="mb-3">
                <label asp-for="NuevaContrasena" class="form-label">Contraseña nueva</label>
                <div class="input-group">
                    <input asp-for="NuevaContrasena" id="clave1" type="password" class="form-control" maxlength="100" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary" id="verClave" title="Mostrar u ocultar">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="generar" title="Generar una contraseña segura">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Generar
                    </button>
                </div>
                <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                <div class="form-text">Mínimo 8 caracteres, con letras y números.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarContrasena" class="form-label">Repetir contraseña</label>
                <input asp-for="ConfirmarContrasena" id="clave2" type="password" class="form-control" maxlength="100" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
            </div>

            <div class="alert alert-light border small mb-0">
                <i class="fa-solid fa-circle-info me-1"></i>
                Al guardar se <strong>desbloquea</strong> la cuenta y se <strong>cierran sus sesiones abiertas</strong>.
                Entrégale la contraseña a la persona por un medio seguro.
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn chaski-btn-primary px-4">
            <i class="fa-solid fa-floppy-disk me-1"></i> Restablecer contraseña
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var c1 = document.getElementById('clave1'), c2 = document.getElementById('clave2');
            document.getElementById('verClave').addEventListener('click', function () {
                var t = c1.type === 'password' ? 'text' : 'password';
                c1.type = t; c2.type = t;
            });
            // Genera 12 caracteres con letras y números (sin los que se confunden: 0, O, 1, l, I)
            document.getElementById('generar').addEventListener('click', function () {
                var letras = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ', nums = '23456789';
                var todo = letras + nums, buf = new Uint32Array(12), s = '';
                crypto.getRandomValues(buf);
                for (var i = 0; i < 12; i++) s += todo[buf[i] % todo.length];
                // Garantiza al menos una letra y un número
                s = letras[buf[0] % letras.length] + s.slice(1, 11) + nums[buf[11] % nums.length];
                c1.value = s; c2.value = s;
                c1.type = 'text'; c2.type = 'text';
            });
        })();
    </script>
}
