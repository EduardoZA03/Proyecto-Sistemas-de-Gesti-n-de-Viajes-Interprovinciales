@model CiudadFormVM
@{
    var editando = Model.IdCiudad.HasValue;
    ViewData["Title"] = editando ? "Editar ciudad" : "Nueva ciudad";
}

<nav class="text-muted small mb-2">INICIO &gt; <a asp-action="Index" class="text-muted text-decoration-none">CIUDADES</a> &gt; <span class="text-dark fw-bold">@(editando ? "EDITAR" : "NUEVA")</span></nav>
<h4 class="fw-bold mb-4"><i class="fa-solid fa-city me-2"></i>@(editando ? "Editar ciudad" : "Agregar una ciudad")</h4>

<form asp-action="@(editando ? "Editar" : "Nueva")" asp-route-id="@Model.IdCiudad" method="post" autocomplete="off">
    <div class="card mb-3" style="max-width: 720px;">
        <div class="card-body">
            <h6 class="fw-bold text-teal mb-3">DATOS DE LA CIUDAD</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Departamento" class="form-label">Departamento</label>
                    <select asp-for="Departamento" class="form-select">
                        <option value="">— Elige —</option>
                        @foreach (var dep in WebApplication1.Data.Departamentos.Todos)
                        {
                            <option value="@dep" selected="@(Model.Departamento == dep)">@dep</option>
                        }
                    </select>
                    <span asp-validation-for="Departamento" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select">
                        @foreach (var s in new[] { "Activo", "Inactivo" })
                        {
                            <option value="@s" selected="@(Model.Estado == s)">@s</option>
                        }
                    </select>
                    <span asp-validation-for="Estado" class="text-danger small"></span>
                    <div class="form-text">Una ciudad inactiva no aparece al reservar ni al crear rutas.</div>
                </div>
            </div>

            @if (editando && Model.RutasTotal > 0)
            {
                <div class="alert alert-light border small mt-3 mb-0">
                    <i class="fa-solid fa-route me-1"></i>
                    Esta ciudad forma parte de <strong>@Model.RutasTotal ruta(s)</strong>. Si cambias su nombre, se actualiza en todas.
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn chaski-btn-primary px-4">
            <i class="fa-solid fa-floppy-disk me-1"></i> @(editando ? "Guardar cambios" : "Agregar ciudad")
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
