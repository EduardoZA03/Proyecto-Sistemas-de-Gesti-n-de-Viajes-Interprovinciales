@model ConfiguracionVM
@{
    ViewData["Title"] = "Configuración";
}

<nav class="text-muted small mb-2">INICIO &gt; <span class="text-dark fw-bold">CONFIGURACIÓN</span></nav>
<h4 class="fw-bold"><i class="fa-solid fa-gear me-2"></i>Configuración del Sistema</h4>
<p class="text-muted">Administra tus preferencias, datos de usuario y configuraciones generales del sistema.</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- TABS -->
<ul class="nav nav-tabs mb-4" id="configTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#perfil" type="button">
            <i class="fa-solid fa-user me-1"></i> Mi Perfil
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#preferencias" type="button">
            <i class="fa-solid fa-sliders me-1"></i> Preferencias
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#parametros" type="button">
            <i class="fa-solid fa-gear me-1"></i> Parámetros del Sistema
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#seguridad" type="button">
            <i class="fa-solid fa-shield-halved me-1"></i> Seguridad
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#auditoria" type="button">
            <i class="fa-solid fa-file-lines me-1"></i> Auditoría
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- MI PERFIL -->
    <div class="tab-pane fade show active" id="perfil">
        <div class="row">
            <div class="col-md-7 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Información del Usuario</h6>
                        <form asp-action="GuardarPerfil" method="post">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label">ID de usuario</label>
                                    <input asp-for="NombreUsuario" class="form-control" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nombres</label>
                                    <input asp-for="Nombres" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Apellidos</label>
                                    <input asp-for="Apellidos" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Correo electrónico</label>
                                    <input asp-for="Correo" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Teléfono</label>
                                    <input asp-for="Telefono" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">DNI</label>
                                    <input asp-for="Dni" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Cargo</label>
                                    <input asp-for="Cargo" class="form-control" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Sucursal</label>
                                    <input asp-for="Sucursal" class="form-control" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de registro</label>
                                    <input value="@Model.FechaRegistro.ToString("dd/MM/yyyy")" class="form-control" readonly />
                                </div>
                            </div>
                            <button type="submit" class="btn chaski-btn-primary mt-3">
                                <i class="fa-solid fa-lock me-1"></i> Guardar cambios
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-5 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Cambiar Contraseña</h6>
                        <form asp-action="CambiarContrasena" method="post">
                            <div class="mb-2">
                                <label class="form-label">Contraseña actual</label>
                                <input asp-for="ContrasenaActual" type="password" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Nueva contraseña</label>
                                <input asp-for="NuevaContrasena" type="password" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Confirmar nueva contraseña</label>
                                <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
                            </div>
                            <div class="alert alert-light small border">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                La contraseña debe tener al menos 8 caracteres, incluyendo letras y números.
                            </div>
                            <button type="submit" class="btn chaski-btn-primary w-100">
                                <i class="fa-solid fa-lock me-1"></i> Cambiar contraseña
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-7 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Sesiones Activas</h6>
                        <p class="text-muted small">Dispositivos donde has iniciado sesión actualmente.</p>
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Dispositivo</th>
                                    <th>Navegador</th>
                                    <th>Ubicación</th>
                                    <th>Último acceso</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sesiones)
                                {
                                    <tr>
                                        <td>@s.Dispositivo</td>
                                        <td>@s.Navegador</td>
                                        <td>@s.Ubicacion</td>
                                        <td>@s.UltimoAcceso.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (s.EsEsteDispositivo)
                                            {
                                                <span class="badge bg-primary-subtle text-primary">Este dispositivo</span>
                                            }
                                            else if (s.Activa)
                                            {
                                                <span class="badge bg-success-subtle text-success">Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Cerrada</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button class="btn btn-outline-danger btn-sm">
                            <i class="fa-solid fa-rotate me-1"></i> Cerrar sesión en todos los dispositivos
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-5 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Acciones de Cuenta</h6>
                        <a class="d-flex justify-content-between align-items-center text-decoration-none text-dark py-2 border-bottom">
                            <span><i class="fa-solid fa-lock text-primary me-2"></i>Cambiar contraseña</span>
                            <i class="fa-solid fa-chevron-right text-muted"></i>
                        </a>
                        <a class="d-flex justify-content-between align-items-center text-decoration-none text-dark py-2 border-bottom">
                            <span><i class="fa-solid fa-right-from-bracket text-warning me-2"></i>Cerrar sesión</span>
                            <i class="fa-solid fa-chevron-right text-muted"></i>
                        </a>
                        <a class="d-flex justify-content-between align-items-center text-decoration-none text-dark py-2">
                            <span><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Eliminar cuenta (solo admins)</span>
                            <i class="fa-solid fa-chevron-right text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs vacíos por ahora -->
    <div class="tab-pane fade" id="preferencias"><p class="text-muted">Próximamente.</p></div>
    <div class="tab-pane fade" id="parametros"><p class="text-muted">Próximamente.</p></div>
    <div class="tab-pane fade" id="seguridad"><p class="text-muted">Próximamente.</p></div>
    <div class="tab-pane fade" id="auditoria"><p class="text-muted">Próximamente.</p></div>
</div>