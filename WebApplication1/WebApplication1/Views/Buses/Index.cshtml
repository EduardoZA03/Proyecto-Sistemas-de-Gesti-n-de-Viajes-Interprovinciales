@model BusesIndexVM
@{
    ViewData["Title"] = "Buses";
}

<nav class="text-muted small mb-2">INICIO &gt; <span class="text-dark fw-bold">BUSES</span></nav>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="fa-solid fa-bus-simple me-2"></i>Flota de Buses</h4>
    <a asp-action="Nuevo" class="btn chaski-btn-primary px-4">
        <i class="fa-solid fa-plus me-1"></i> Nuevo bus
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- RESUMEN DE LA FLOTA -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">OPERATIVOS</div>
                    <div class="fs-3 fw-bold">@Model.Operativos</div>
                </div>
                <i class="fa-solid fa-circle-check fa-2x text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">EN MANTENIMIENTO</div>
                    <div class="fs-3 fw-bold">@Model.EnMantenimiento</div>
                </div>
                <i class="fa-solid fa-screwdriver-wrench fa-2x text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card kpi-danger h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">DE BAJA</div>
                    <div class="fs-3 fw-bold">@Model.DeBaja</div>
                </div>
                <i class="fa-solid fa-ban fa-2x text-danger"></i>
            </div>
        </div>
    </div>
</div>

<!-- FILTROS -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                    @foreach (var op in new[] { "Todos", "Operativo", "Mantenimiento", "Baja" })
                    {
                        <option value="@op" selected="@(Model.Estado == op)">@op</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Servicio</label>
                <select name="servicio" class="form-select">
                    @foreach (var op in new[] { "Todos", "Ejecutivo", "Semi Cama", "Cama Suite" })
                    {
                        <option value="@op" selected="@(Model.Servicio == op)">@op</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Placa, marca o modelo</label>
                <input name="texto" value="@Model.Texto" class="form-control" placeholder="Buscar..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn chaski-btn-primary w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- LISTADO -->
<div class="card">
    <div class="card-body">
        <h6 class="fw-bold text-teal mb-3">LISTADO DE BUSES <span class="text-muted fw-normal">(@Model.Buses.Count)</span></h6>
        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Placa</th>
                        <th>Bus</th>
                        <th>Servicio</th>
                        <th>Asientos</th>
                        <th>Viajes</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Buses)
                    {
                        var badge = b.Estado switch
                        {
                            "Operativo" => "bg-success-subtle text-success",
                            "Mantenimiento" => "bg-warning-subtle text-warning",
                            _ => "bg-danger-subtle text-danger"
                        };
                        <tr>
                            <td class="fw-semibold text-nowrap">@b.Placa</td>
                            <td>@b.Marca @b.Modelo<br /><span class="text-muted small">Año @b.Anio</span></td>
                            <td>@b.Servicio</td>
                            <td class="text-nowrap">@b.Capacidad <span class="text-muted small">· @b.Pisos @(b.Pisos == 1 ? "piso" : "pisos")</span></td>
                            <td class="text-nowrap">
                                @b.ViajesProximos <span class="text-muted small">por salir</span>
                                <br /><span class="text-muted small">@b.ViajesTotal en total</span>
                            </td>
                            <td><span class="badge @badge">@b.Estado</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@b.IdBus" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-pen me-1"></i> Editar
                                </a>
                                @if (b.PuedeEliminar)
                                {
                                    <form asp-action="Eliminar" asp-route-id="@b.IdBus" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar el bus @b.Placa y sus @b.Capacidad asientos? Esta acción no se puede deshacer.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash me-1"></i> Eliminar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Buses.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay buses con esos filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            Un bus con viajes registrados no se elimina: se da de baja desde <strong>Editar</strong> para conservar el historial.
        </p>
    </div>
</div>
