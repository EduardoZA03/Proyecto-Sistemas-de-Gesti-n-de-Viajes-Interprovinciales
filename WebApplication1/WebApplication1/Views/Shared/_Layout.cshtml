<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chaski-Ruta</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Font Awesome (iconos) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Estilos propios del proyecto -->
    <link rel="stylesheet" href="~/css/chaski.css" asp-append-version="true" />
</head>
<body>

    <!-- HEADER -->
    <header class="chaski-header d-flex align-items-center px-3">
        <img src="~/images/logo-chaski.png" class="chaski-logo me-3" alt="Chaski-Ruta" />
        <div class="chaski-title @(User.Identity?.IsAuthenticated == true ? "" : "flex-grow-1")">
            <div class="fw-bold">SISTEMA INTEGRAL DE GESTIÓN</div>
            <div class="fw-bold">Y CONTROL DE VIAJES INTERPROVINCIALES</div>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Component.InvokeAsync("HeaderInfo")
            <div class="chaski-user d-flex align-items-center gap-2 ms-auto">
                <i class="fa-solid fa-circle-user fa-2x"></i>
                <div class="lh-sm">
                    <div>@User.FindFirst("NombreCompleto")?.Value</div>
                    <div class="small opacity-75">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
                <form asp-controller="Cuenta" asp-action="Salir" method="post" class="ms-2 mb-0">
                    <button type="submit" class="btn btn-sm btn-outline-light" title="Cerrar sesión">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Salir
                    </button>
                </form>
            </div>
        }
    </header>

    <div class="d-flex">
        <!-- SIDEBAR -->
        @if (User.Identity?.IsAuthenticated == true)
        {
        <nav class="chaski-sidebar">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house me-2"></i> Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" ? "active" : "")"
                       asp-controller="Reservas" asp-action="Index">
                        <i class="fa-solid fa-bus me-2"></i> Reservas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index">
                        <i class="fa-solid fa-ticket me-2"></i> Ventas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cancelaciones" ? "active" : "")"
                       asp-controller="Cancelaciones" asp-action="Index">
                        <i class="fa-solid fa-circle-xmark me-2"></i> Cancelaciones
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Viajes" ? "active" : "")"
                           asp-controller="Viajes" asp-action="Index">
                            <i class="fa-solid fa-route me-2"></i> Viajes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Buses" ? "active" : "")"
                           asp-controller="Buses" asp-action="Index">
                            <i class="fa-solid fa-bus-simple me-2"></i> Buses
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">
                            <i class="fa-solid fa-clipboard-list me-2"></i> Reportes
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracion" ? "active" : "")"
                       asp-controller="Configuracion" asp-action="Index">
                        <i class="fa-solid fa-gear me-2"></i> Configuración
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Registro" ? "active" : "")"
                           asp-controller="Cuenta" asp-action="Registro">
                            <i class="fa-solid fa-user-plus me-2"></i> Crear cuenta
                        </a>
                    </li>
                }
            </ul>
        </nav>
        }

        <!-- CONTENIDO -->
        <main class="chaski-content flex-grow-1 p-4 d-flex flex-column">
            <div class="flex-grow-1">
                @RenderBody()
            </div>

            <!-- FOOTER -->
            <footer class="chaski-footer">
                <div>
                    <strong class="text-teal">Chaski-Ruta</strong>
                    &copy; @DateTime.Now.Year &middot; Sistema Integral de Gestión y Control de Viajes Interprovinciales
                </div>
                <div>
                    <i class="fa-solid fa-code me-1"></i> ASP.NET Core &middot; SQL Server
                </div>
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>