<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chaski-Ruta</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Font Awesome (iconos) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Estilos propios del proyecto -->
    <link rel="stylesheet" href="~/css/chaski.css" asp-append-version="true" />
</head>
<body>

    <!-- HEADER -->
    <header class="chaski-header d-flex align-items-center px-3">
        <img src="~/images/logo-chaski.png" class="chaski-logo me-3" alt="Chaski-Ruta" />
        <div class="chaski-title flex-grow-1">
            <div class="fw-bold">SISTEMA INTEGRAL DE GESTIÓN</div>
            <div class="fw-bold">Y CONTROL DE VIAJES INTERPROVINCIALES</div>
        </div>
        <div class="chaski-user d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-user fa-2x"></i>
            <span>Ejecutivo Comercial</span>
        </div>
    </header>

    <div class="d-flex">
        <!-- SIDEBAR -->
        <nav class="chaski-sidebar">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house me-2"></i> Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" ? "active" : "")"
                       asp-controller="Reservas" asp-action="Index">
                        <i class="fa-solid fa-bus me-2"></i> Reservas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index">
                        <i class="fa-solid fa-ticket me-2"></i> Ventas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cancelaciones" ? "active" : "")"
                       asp-controller="Cancelaciones" asp-action="Index">
                        <i class="fa-solid fa-circle-xmark me-2"></i> Cancelaciones
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")"
                       asp-controller="Reportes" asp-action="Index">
                        <i class="fa-solid fa-clipboard-list me-2"></i> Reportes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracion" ? "active" : "")"
                       asp-controller="Configuracion" asp-action="Index">
                        <i class="fa-solid fa-gear me-2"></i> Configuración
                    </a>
                </li>
            </ul>
        </nav>

        <!-- CONTENIDO -->
        <main class="chaski-content flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>