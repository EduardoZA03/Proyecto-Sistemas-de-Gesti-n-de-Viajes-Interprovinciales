<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chaski-Ruta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/chaski.css" asp-append-version="true" />
</head>
<body class="chaski-auth-bg">
    <main class="container d-flex flex-column align-items-center justify-content-center min-vh-100 py-4">
        @RenderBody()
        <div class="text-white-50 small text-center mt-4">
            <strong class="text-white">Chaski-Ruta</strong> &copy; @DateTime.Now.Year &middot; Sistema Integral de Gestión y Control de Viajes Interprovinciales
        </div>
    </main>
</body>
</html>
