@model NuevaReservaVM
@{
    ViewData["Title"] = "Nueva Reserva";
    var viaje = Model.ViajeSeleccionado;

    // Marca en rojo el campo que tiene un error (los mensajes los muestra asp-validation-for)
    string Inv(string campo) =>
        ViewData.ModelState.TryGetValue(campo, out var entrada) && entrada.Errors.Count > 0 ? "is-invalid" : "";
}

<nav class="text-muted small mb-2">INICIO &gt; RESERVAS &gt; <span class="text-dark fw-bold">NUEVA RESERVA</span></nav>
<h4 class="fw-bold mb-4"><i class="fa-solid fa-ticket me-2"></i>Registrar viaje (Nueva reserva)</h4>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<!-- 1. BÚSQUEDA -->
<div class="card mb-4">
    <div class="card-body">
        <h6 class="fw-bold text-teal mb-3">1. BÚSQUEDA DE VIAJE</h6>
        <form asp-action="BuscarViajes" method="post" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="Origen" class="form-label">Origen</label>
                <select asp-for="Origen" asp-items="Model.Ciudades" class="form-select">
                    <option value="">Cualquier origen</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Destino" class="form-label">Destino</label>
                <select asp-for="Destino" asp-items="Model.Ciudades" class="form-select">
                    <option value="">Cualquier destino</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="FechaViaje" class="form-label">Fecha <span class="text-muted small">(opcional)</span></label>
                <input asp-for="FechaViaje" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label asp-for="Pasajeros" class="form-label">Pasajeros</label>
                <input asp-for="Pasajeros" type="number" min="1" max="10" class="form-control" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn chaski-btn-primary w-100" title="Buscar viajes">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AvisoBusqueda))
{
    <div class="alert alert-warning d-flex align-items-start" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2 mt-1"></i>
        <div>
            @Model.AvisoBusqueda
            @if (User.IsInRole("Administrador"))
            {
                <div class="mt-1">
                    <a asp-controller="Viajes" asp-action="Nuevo" class="alert-link">
                        <i class="fa-solid fa-plus me-1"></i>Programar un viaje nuevo
                    </a>
                </div>
            }
        </div>
    </div>
}

@if (Model.ViajesDisponibles.Any())
{
    <!-- 2. RESULTADOS -->
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="fw-bold text-teal mb-3">2. SELECCIÓN DE VIAJE DISPONIBLE <span class="text-muted fw-normal">(@Model.ViajesDisponibles.Count)</span></h6>
            <form asp-action="SeleccionarViaje" method="post">
                <input type="hidden" asp-for="Origen" />
                <input type="hidden" asp-for="Destino" />
                <input type="hidden" asp-for="FechaViaje" />
                <input type="hidden" asp-for="Pasajeros" />
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th></th>
                                <th>Ruta</th>
                                <th>Salida</th>
                                <th>Llegada</th>
                                <th>Servicio</th>
                                <th>Duración</th>
                                <th>Precio desde</th>
                                <th>Asientos disp.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.ViajesDisponibles)
                            {
                                <tr>
                                    <td><input type="radio" name="IdViajeSeleccionado" value="@v.IdViaje" checked="@(Model.IdViajeSeleccionado == v.IdViaje)" required /></td>
                                    <td class="fw-semibold text-nowrap">@v.Ruta</td>
                                    <td class="text-nowrap">@v.HoraSalida</td>
                                    <td class="text-nowrap">@v.HoraLlegada</td>
                                    <td>@v.Servicio</td>
                                    <td class="text-nowrap">@v.Duracion</td>
                                    <td class="text-nowrap">S/ @v.PrecioDesde.ToString("0.00")</td>
                                    <td><span class="badge bg-success-subtle text-success">@v.AsientosDisponibles</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="submit" class="btn chaski-btn-primary">Continuar con este viaje</button>
            </form>
        </div>
    </div>
}

@if (Model.Asientos.Any())
{
    <!-- VIAJE ELEGIDO: se muestra el viaje real para evitar equivocaciones -->
    @if (viaje != null)
    {
        <div class="alert alert-info d-flex align-items-center gap-3" role="alert">
            <i class="fa-solid fa-route fa-lg"></i>
            <div>
                <strong>Viaje elegido:</strong> @viaje.Ruta
                &middot; @viaje.Salida.ToString("dd/MM/yyyy HH:mm")
                &middot; @viaje.Servicio
                &middot; llega aprox. @viaje.HoraLlegada
            </div>
        </div>
    }

    <form asp-action="GuardarReserva" method="post" id="formReserva" novalidate autocomplete="off">
        <input type="hidden" asp-for="IdViajeSeleccionado" />
        <input type="hidden" asp-for="Origen" />
        <input type="hidden" asp-for="Destino" />
        <input type="hidden" asp-for="FechaViaje" />
        <input type="hidden" asp-for="Pasajeros" />
        <div class="row">
            <!-- 4. ASIENTOS -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">4. SELECCIÓN DE ASIENTO</h6>
                        <div class="d-flex flex-wrap gap-2 mb-3" id="seatMap">
                            @foreach (var a in Model.Asientos)
                            {
                                var claseEstado = a.Estado == "Ocupado"
                                    ? "seat-ocupado"
                                    : a.IdAsiento == Model.AsientoSeleccionado ? "seat-disponible seat-seleccionado" : "seat-disponible";
                                <div class="seat @claseEstado" data-id="@a.IdAsiento" onclick="seleccionarAsiento(this)">@a.Numero</div>
                            }
                        </div>
                        <input type="hidden" id="AsientoSeleccionado" name="AsientoSeleccionado" asp-for="AsientoSeleccionado" />
                        <div class="d-flex gap-3 small">
                            <span><span class="seat-legend seat-disponible"></span> Disponible</span>
                            <span><span class="seat-legend seat-ocupado"></span> Ocupado</span>
                            <span><span class="seat-legend seat-seleccionado"></span> Seleccionado</span>
                        </div>
                        <span asp-validation-for="AsientoSeleccionado" class="text-danger small d-block mt-2"></span>
                    </div>
                </div>
            </div>

            <!-- 5. DATOS DEL PASAJERO -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">5. DATOS DEL PASAJERO</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="TipoDocumento" class="form-label">Tipo documento</label>
                                <select asp-for="TipoDocumento" class="form-select @(Inv("TipoDocumento"))">
                                    <option value="DNI">DNI</option>
                                    <option value="Carné Extranjería">Carné Extranjería</option>
                                    <option value="Pasaporte">Pasaporte</option>
                                </select>
                                <span asp-validation-for="TipoDocumento" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="NumeroDocumento" class="form-label">Número documento</label>
                                <input asp-for="NumeroDocumento" class="form-control @(Inv("NumeroDocumento"))" maxlength="12" inputmode="numeric" />
                                <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Nombres" class="form-label">Nombres</label>
                                <input asp-for="Nombres" class="form-control @(Inv("Nombres"))" maxlength="100" />
                                <span asp-validation-for="Nombres" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Apellidos" class="form-label">Apellidos</label>
                                <input asp-for="Apellidos" class="form-control @(Inv("Apellidos"))" maxlength="100" />
                                <span asp-validation-for="Apellidos" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Telefono" class="form-label">Teléfono <span class="text-muted small">(opcional)</span></label>
                                <input asp-for="Telefono" class="form-control @(Inv("Telefono"))" maxlength="15" inputmode="tel" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Correo" class="form-label">Correo <span class="text-muted small">(opcional)</span></label>
                                <input asp-for="Correo" class="form-control @(Inv("Correo"))" maxlength="100" inputmode="email" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Edad" class="form-label">Edad</label>
                                <input asp-for="Edad" type="number" min="0" max="120" class="form-control @(Inv("Edad"))" />
                                <span asp-validation-for="Edad" class="text-danger small"></span>
                                <div class="form-text">Define la tarifa: Niño (menor de 12), Tercera Edad (60 o más) o General.</div>
                            </div>
                            <div class="col-6">
                                <label asp-for="Genero" class="form-label">Género</label>
                                <select asp-for="Genero" class="form-select">
                                    <option>Masculino</option>
                                    <option>Femenino</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RESUMEN: ruta y fecha del viaje realmente elegido -->
        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    @if (viaje != null)
                    {
                        <strong>Ruta:</strong> @viaje.Ruta <span>&nbsp;|&nbsp;</span>
                        <strong>Salida:</strong> @viaje.Salida.ToString("dd/MM/yyyy HH:mm")
                    }
                </div>
                <button type="submit" class="btn chaski-btn-primary px-4" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar reserva
                </button>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        function seleccionarAsiento(el) {
            if (el.classList.contains('seat-ocupado')) return;
            document.querySelectorAll('.seat-seleccionado').forEach(function (s) { s.classList.remove('seat-seleccionado'); });
            el.classList.add('seat-seleccionado');
            document.getElementById('AsientoSeleccionado').value = el.dataset.id;
            var aviso = document.querySelector('[data-valmsg-for="AsientoSeleccionado"]');
            if (aviso) aviso.textContent = '';
        }

        // Validación inmediata en el navegador (el servidor vuelve a validar todo)
        (function () {
            var form = document.getElementById('formReserva');
            if (!form) return;

            var reglas = {
                'DNI': { re: /^\d{8}$/, max: 8, modo: 'numeric', msg: 'El DNI debe tener exactamente 8 dígitos.' },
                'Carné Extranjería': { re: /^[A-Za-z0-9]{9,12}$/, max: 12, modo: 'text', msg: 'El carné de extranjería debe tener entre 9 y 12 letras o números.' },
                'Pasaporte': { re: /^[A-Za-z0-9]{6,12}$/, max: 12, modo: 'text', msg: 'El pasaporte debe tener entre 6 y 12 letras o números.' }
            };
            var tipo = document.getElementById('TipoDocumento');
            var doc = document.getElementById('NumeroDocumento');
            function ajustarDocumento() {
                var r = reglas[tipo.value];
                if (r) { doc.maxLength = r.max; doc.inputMode = r.modo; }
            }
            tipo.addEventListener('change', ajustarDocumento);
            ajustarDocumento();

            var nombreRe = /^\p{L}[\p{L} .'\-]{1,99}$/u;
            var telRe = /^[0-9+ ]{6,15}$/;
            // En Razor la arroba se escribe doble (@@) dentro del JavaScript
            var correoRe = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            function marcar(campo, texto) {
                var span = form.querySelector('[data-valmsg-for="' + campo + '"]');
                if (span) span.textContent = texto || '';
                var el = document.getElementById(campo);
                if (el) el.classList.toggle('is-invalid', !!texto);
                return texto ? campo : null;
            }

            // Al escribir en un campo se quita su error
            form.addEventListener('input', function (ev) { if (ev.target.id) marcar(ev.target.id, ''); });
            form.addEventListener('change', function (ev) { if (ev.target.id) marcar(ev.target.id, ''); });

            form.addEventListener('submit', function (ev) {
                var errores = [];
                function revisar(campo, texto) { var e = marcar(campo, texto); if (e) errores.push(e); }

                var nombres = form.elements['Nombres'].value.trim().replace(/\s+/g, ' ');
                var apellidos = form.elements['Apellidos'].value.trim().replace(/\s+/g, ' ');
                var numero = doc.value.trim();
                var telefono = form.elements['Telefono'].value.trim();
                var correo = form.elements['Correo'].value.trim();
                var edadTxt = form.elements['Edad'].value.trim();
                var edad = parseInt(edadTxt, 10);

                revisar('AsientoSeleccionado', document.getElementById('AsientoSeleccionado').value ? '' : 'Elige un asiento en el mapa.');
                revisar('Nombres', nombres === '' ? 'Ingresa los nombres.' : (!nombreRe.test(nombres) ? 'Los nombres solo pueden tener letras, espacios, punto, guion o apóstrofe (mínimo 2 caracteres).' : ''));
                revisar('Apellidos', apellidos === '' ? 'Ingresa los apellidos.' : (!nombreRe.test(apellidos) ? 'Los apellidos solo pueden tener letras, espacios, punto, guion o apóstrofe (mínimo 2 caracteres).' : ''));
                var r = reglas[tipo.value];
                revisar('NumeroDocumento', numero === '' ? 'Ingresa el número de documento.' : (r && !r.re.test(numero) ? r.msg : ''));
                revisar('Telefono', telefono !== '' && !telRe.test(telefono) ? 'El teléfono debe tener entre 6 y 15 dígitos (puede llevar + y espacios).' : '');
                revisar('Correo', correo !== '' && !correoRe.test(correo) ? 'El correo no es válido (ejemplo: nombre@correo.com).' : '');
                revisar('Edad', edadTxt === '' ? 'Ingresa la edad del pasajero.' : (isNaN(edad) || edad < 0 || edad > 120 ? 'La edad debe estar entre 0 y 120 años.' : ''));

                if (errores.length) {
                    ev.preventDefault();
                    var primero = errores[0] === 'AsientoSeleccionado' ? document.getElementById('seatMap') : document.getElementById(errores[0]);
                    if (primero) primero.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }

                // Evita guardar dos veces por un doble clic
                var btn = document.getElementById('btnGuardar');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
            });
        })();
    </script>
}
