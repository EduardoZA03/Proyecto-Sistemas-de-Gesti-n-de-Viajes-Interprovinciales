@model VentasIndexVM
@{
    ViewData["Title"] = "Ventas";
}

<nav class="text-muted small mb-2">INICIO &gt; <span class="text-dark fw-bold">VENTAS</span></nav>
<h4 class="fw-bold"><i class="fa-solid fa-ticket me-2"></i>Gestión de Ventas</h4>
<p class="text-muted">Consulta y administra las ventas realizadas. Puedes buscar, filtrar y generar comprobantes.</p>

@if (ViewData["Aviso"] != null)
{
    <div class="alert alert-warning">@ViewData["Aviso"]</div>
}

<!-- FILTROS -->
<div class="card mb-4">
    <div class="card-body">
        <h6 class="fw-bold text-teal mb-3">FILTROS DE BÚSQUEDA</h6>
        <form asp-action="Index" method="post" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Fecha inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Fecha fin</label>
                <input asp-for="FechaFin" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option>Todos</option>
                    <option>Pagado</option>
                    <option>Pendiente</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Método de pago</label>
                <select asp-for="MetodoPago" class="form-select">
                    <option>Todos</option>
                    <option>Efectivo</option>
                    <option>Tarjeta</option>
                    <option>Yape</option>
                    <option>Plin</option>
                    <option>Transferencia</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Pasajero</label>
                <input asp-for="Pasajero" class="form-control" placeholder="Nombre o documento" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn chaski-btn-primary w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPIs -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">TOTAL VENTAS</div>
                    <div class="fs-4 fw-bold">S/ @Model.TotalVentas.ToString("N2")</div>
                    <div class="text-muted small">Ventas en el período</div>
                </div>
                <i class="fa-solid fa-sack-dollar fa-2x text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">TOTAL TRANSACCIONES</div>
                    <div class="fs-4 fw-bold">@Model.TotalTransacciones</div>
                    <div class="text-muted small">Ventas realizadas</div>
                </div>
                <i class="fa-solid fa-cart-shopping fa-2x text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">VENTA PROMEDIO</div>
                    <div class="fs-4 fw-bold">S/ @Model.VentaPromedio.ToString("N2")</div>
                    <div class="text-muted small">Por transacción</div>
                </div>
                <i class="fa-solid fa-chart-line fa-2x text-teal"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">VENTAS HOY</div>
                    <div class="fs-4 fw-bold">S/ @Model.VentasHoy.ToString("N2")</div>
                    <div class="text-muted small">@DateTime.Today.ToString("dd/MM/yyyy")</div>
                </div>
                <i class="fa-solid fa-calendar-day fa-2x text-warning"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- LISTADO -->
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h6 class="fw-bold text-teal mb-0">LISTADO DE VENTAS</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-file-pdf me-1"></i> Reporte PDF</button>
                        <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-file-excel me-1"></i> Exportar a Excel</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()"><i class="fa-solid fa-rotate me-1"></i> Actualizar</button>
                    </div>
                </div>
<div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Fecha</th>
                            <th>Pasajero</th>
                            <th>Ruta</th>
                            <th>Asientos</th>
                            <th>Monto</th>
                            <th>Pago</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Ventas)
                        {
                            <tr>
                                <td class="text-nowrap">@v.Codigo</td>
                                <td class="text-nowrap">@v.Fecha.ToString("dd/MM/yyyy")<br /><span class="text-muted small">@v.Fecha.ToString("HH:mm")</span></td>
                                <td>@v.Pasajero<br /><span class="text-muted small">DNI: @v.Documento</span></td>
                                <td>@v.Ruta</td>
                                <td>@v.Asientos</td>
                                <td class="text-nowrap">S/ @v.MontoTotal.ToString("0.00")</td>
                                <td class="text-nowrap">@v.MetodoPago</td>
                                <td><span class="badge bg-success-subtle text-success">@v.Estado</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            onclick="verDetalle('@v.Codigo')">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
</div>
            </div>
        </div>
    </div>

    <!-- DETALLE: panel deslizable -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="panelDetalle" aria-labelledby="panelDetalleTitulo">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="panelDetalleTitulo"><i class="fa-solid fa-receipt me-2 text-teal"></i>Detalle</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body" id="detalleVenta"></div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalle(codigo) {
            const cuerpo = document.getElementById('detalleVenta');
            cuerpo.innerHTML = '<p class="text-muted text-center">Cargando…</p>';
            bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('panelDetalle')).show();
            fetch('/Ventas/Detalle?codigo=' + encodeURIComponent(codigo))
                .then(r => r.text())
                .then(html => cuerpo.innerHTML = html);
        }
    </script>
}
