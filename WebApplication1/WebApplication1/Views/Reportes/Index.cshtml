@model ReportesIndexVM
@{
    ViewData["Title"] = "Reportes";
}

<nav class="text-muted small mb-2">INICIO &gt; <span class="text-dark fw-bold">REPORTES</span></nav>
<h4 class="fw-bold"><i class="fa-solid fa-clipboard-list me-2"></i>Reportes Analíticos</h4>
<p class="text-muted">Consulta y analiza la información de operaciones para la toma de decisiones estratégicas.</p>

@if (ViewData["Aviso"] != null)
{
    <div class="alert alert-warning">@ViewData["Aviso"]</div>
}

<div class="row">
    <div class="col-md-9">
        <!-- FILTROS -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-teal mb-3">FILTROS DE REPORTE</h6>
                <form asp-action="Index" method="post" class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Tipo de reporte</label>
                        <select asp-for="TipoReporte" class="form-select">
                            <option>Todos los reportes</option>
                            <option>Ventas por período</option>
                            <option>Ocupación por ruta</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha fin</label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ruta</label>
                        <select asp-for="Ruta" class="form-select">
                            <option>Todas las rutas</option>
                            @foreach (var r in Model.RutasDisponibles)
                            {
                                <option>@r</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Servicio</label>
                        <select asp-for="Servicio" class="form-select">
                            <option>Todos los servicios</option>
                            @foreach (var s in Model.ServiciosDisponibles)
                            {
                                <option>@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn chaski-btn-primary flex-grow-1">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- KPIs -->
        <div class="row mb-4 g-3">
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <div class="text-muted small">TOTAL INGRESOS</div>
                        <div class="fs-4 fw-bold">S/ @Model.TotalIngresos.ToString("N2")</div>
                        <div class="text-muted small">En el período seleccionado</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <div class="text-muted small">TOTAL PASAJEROS</div>
                        <div class="fs-4 fw-bold">@Model.TotalPasajeros.ToString("N0")</div>
                        <div class="text-muted small">En el período seleccionado</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <div class="text-muted small">TASA DE OCUPACIÓN PROM.</div>
                        <div class="fs-4 fw-bold">@Model.TasaOcupacionProm.ToString("0.0")%</div>
                        <div class="text-muted small">Promedio general</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <div class="text-muted small">TOTAL VIAJES</div>
                        <div class="fs-4 fw-bold">@Model.TotalViajes</div>
                        <div class="text-muted small">En el período seleccionado</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS FILA 1 -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Ingresos por día</h6>
                        <canvas id="chartIngresos" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Tasa de ocupación por día (%)</h6>
                        <canvas id="chartOcupacion" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS FILA 2 -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Pasajeros por ruta</h6>
                        <canvas id="chartRutas" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold text-teal mb-3">Ingresos por servicio</h6>
                        <canvas id="chartServicios" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold text-teal mb-3">ACCIONES RÁPIDAS</h6>
                <button class="btn btn-outline-secondary w-100 mb-2 text-start"><i class="fa-solid fa-file-pdf me-2"></i>Exportar a PDF</button>
                <button class="btn btn-outline-secondary w-100 mb-2 text-start"><i class="fa-solid fa-file-excel me-2"></i>Exportar a Excel</button>
                <button class="btn btn-outline-secondary w-100 mb-2 text-start"><i class="fa-solid fa-print me-2"></i>Imprimir reporte</button>
                <button class="btn btn-outline-secondary w-100 text-start"><i class="fa-solid fa-calendar-plus me-2"></i>Programar reporte</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const teal = '#17a6a0';
        const orange = '#e8871a';

        new Chart(document.getElementById('chartIngresos'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.FechasLabels)),
                datasets: [{
                    label: 'Ingresos (S/)',
                    data: @Html.Raw(Json.Serialize(Model.IngresosPorDia)),
                    borderColor: teal,
                    backgroundColor: 'rgba(23,166,160,0.15)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: { plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('chartOcupacion'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.FechasLabels)),
                datasets: [{
                    label: 'Ocupación (%)',
                    data: @Html.Raw(Json.Serialize(Model.OcupacionPorDia)),
                    backgroundColor: teal
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { max: 100 } } }
        });

        new Chart(document.getElementById('chartRutas'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RutasLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.PasajerosPorRuta)),
                    backgroundColor: [teal, '#4aa8f0', orange, '#8e6ee0', '#b0b0b0']
                }]
            }
        });

        new Chart(document.getElementById('chartServicios'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ServiciosLabels)),
                datasets: [{
                    label: 'Ingresos (S/)',
                    data: @Html.Raw(Json.Serialize(Model.IngresosPorServicio)),
                    backgroundColor: teal
                }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    </script>
}