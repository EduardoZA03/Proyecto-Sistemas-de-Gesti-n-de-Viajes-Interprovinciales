@model ViajesIndexVM
@{
    ViewData["Title"] = "Viajes";
}

<nav class="text-muted small mb-2">INICIO &gt; <span class="text-dark fw-bold">VIAJES</span></nav>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="fa-solid fa-route me-2"></i>Programación de Viajes</h4>
    <a asp-action="Nuevo" class="btn chaski-btn-primary px-4">
        <i class="fa-solid fa-plus me-1"></i> Nuevo viaje
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- FILTROS -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                    @foreach (var op in new[] { "Programado", "Finalizado", "Cancelado", "Todos" })
                    {
                        <option value="@op" selected="@(Model.Estado == op)">@op</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Ruta</label>
                <select name="idRuta" class="form-select" asp-items="Model.Rutas"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input name="desde" type="date" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input name="hasta" type="date" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn chaski-btn-primary w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- LISTADO -->
<div class="card">
    <div class="card-body">
        <h6 class="fw-bold text-teal mb-3">LISTADO DE VIAJES <span class="text-muted fw-normal">(@Model.Viajes.Count)</span></h6>
        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Ruta</th>
                        <th>Bus</th>
                        <th>Salida</th>
                        <th>Precio base</th>
                        <th style="min-width: 190px;">Ocupación</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Viajes)
                    {
                        var pct = v.Capacidad == 0 ? 0 : (int)Math.Round(100.0 * v.Vendidos / v.Capacidad);
                        var badge = v.Estado switch
                        {
                            "Programado" => v.YaSalio ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success",
                            "Finalizado" => "bg-secondary-subtle text-secondary",
                            _ => "bg-danger-subtle text-danger"
                        };
                        <tr>
                            <td class="fw-semibold">@v.Ruta</td>
                            <td>@v.Placa<br /><span class="text-muted small">@v.Servicio</span></td>
                            <td class="text-nowrap">@v.Salida.ToString("dd/MM/yyyy")<br /><span class="text-muted small">@v.Salida.ToString("HH:mm")</span></td>
                            <td class="text-nowrap">S/ @v.PrecioBase.ToString("0.00")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar @(pct >= 70 ? "bg-success" : pct >= 30 ? "bg-info" : "bg-secondary")" style="width: @(pct)%"></div>
                                    </div>
                                    <span class="small text-muted text-nowrap">@v.Vendidos/@v.Capacidad</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @badge">@(v.Estado == "Programado" && v.YaSalio ? "Ya salió" : v.Estado)</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (v.PuedeEditar)
                                {
                                    <a asp-action="Editar" asp-route-id="@v.IdViaje" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-pen me-1"></i> Editar
                                    </a>
                                }
                                @if (v.PuedeFinalizar)
                                {
                                    <form asp-action="Finalizar" asp-route-id="@v.IdViaje" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="fa-solid fa-flag-checkered me-1"></i> Finalizar
                                        </button>
                                    </form>
                                }
                                @if (v.PuedeCancelar)
                                {
                                    <form asp-action="Cancelar" asp-route-id="@v.IdViaje" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Cancelar el viaje @v.Ruta del @v.Salida.ToString("dd/MM/yyyy HH:mm")?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-ban me-1"></i> Cancelar
                                        </button>
                                    </form>
                                }
                                @if (v.Estado == "Programado" && !v.YaSalio && v.ReservasActivas > 0)
                                {
                                    <span class="small text-muted" title="Cancela primero las reservas para poder editar o cancelar el viaje.">
                                        <i class="fa-solid fa-lock me-1"></i>@v.ReservasActivas reserva(s)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Viajes.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay viajes con esos filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
